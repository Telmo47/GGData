@page
@model GGData.Areas.Identity.Pages.Account.RegisterModel
@{
    // Define o título da página como "Registar"
    ViewData["Title"] = "Registar";
}

<!-- Cabeçalho principal com o título da página -->
<h1>@ViewData["Title"]</h1>

<!-- Formulário de registo com método POST -->
<form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
    <h2>Criar uma nova conta</h2>

    <!-- Sumário de validação para mostrar erros do modelo -->
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

    <!-- Campo para nome completo -->
    <div class="form-floating mb-3">
        <input asp-for="Input.Nome" class="form-control" placeholder="Nome completo" />
        <label asp-for="Input.Nome">Nome</label>
        <span asp-validation-for="Input.Nome" class="text-danger"></span>
    </div>

    <!-- Campo para email -->
    <div class="form-floating mb-3">
        <input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="email@exemplo.com" />
        <label asp-for="Input.Email">Email</label>
        <span asp-validation-for="Input.Email" class="text-danger"></span>
    </div>

    <!-- Campo para palavra-passe -->
    <div class="form-floating mb-3">
        <input asp-for="Input.Password" class="form-control" autocomplete="new-password" placeholder="Palavra-passe" />
        <label asp-for="Input.Password">Palavra-passe</label>
        <span asp-validation-for="Input.Password" class="text-danger"></span>
    </div>

    <!-- Campo para confirmação da palavra-passe -->
    <div class="form-floating mb-3">
        <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="Confirmar palavra-passe" />
        <label asp-for="Input.ConfirmPassword">Confirmar Palavra-passe</label>
        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
    </div>

    <!-- Dropdown para selecionar tipo de conta -->
    <div class="form-floating mb-3">
        <select asp-for="Input.TipoUsuario" class="form-select">
            <option value="">Seleciona o tipo de conta</option>
            <option value="Utilizador">Utilizador</option>
            <option value="Critico">Crítico</option>
        </select>
        <label asp-for="Input.TipoUsuario">Tipo de Conta</label>
        <span asp-validation-for="Input.TipoUsuario" class="text-danger"></span>
    </div>

    <!-- Campos adicionais que aparecem apenas se o tipo de conta for "Crítico" -->
    <div id="camposCritico" style="display:none;">
        <div class="form-floating mb-3">
            <input asp-for="Input.Instituicao" class="form-control" placeholder="Instituição" />
            <label asp-for="Input.Instituicao">Instituição</label>
            <span asp-validation-for="Input.Instituicao" class="text-danger"></span>
        </div>

        <div class="form-floating mb-3">
            <input asp-for="Input.WebsiteProfissional" class="form-control" placeholder="Website profissional" />
            <label asp-for="Input.WebsiteProfissional">Website Profissional</label>
            <span asp-validation-for="Input.WebsiteProfissional" class="text-danger"></span>
        </div>

        <div class="form-floating mb-3">
            <textarea asp-for="Input.DescricaoProfissional" class="form-control" placeholder="Descrição"></textarea>
            <label asp-for="Input.DescricaoProfissional">Descrição Profissional</label>
            <span asp-validation-for="Input.DescricaoProfissional" class="text-danger"></span>
        </div>
    </div>

    <!-- Botão para submeter o registo -->
    <button id="registerSubmit" type="submit" class="w-100 btn btn-lg btn-primary">Criar Conta</button>
</form>

@section Scripts {
    <!-- Scripts para validação do lado cliente -->
    <partial name="_ValidationScriptsPartial" />

    <!-- Script para mostrar/ocultar campos adicionais dependendo do tipo de utilizador -->
    <script>
        document.getElementById("Input_TipoUsuario").addEventListener("change", function () {
            const tipo = this.value;
            const div = document.getElementById("camposCritico");
            div.style.display = tipo === "Critico" ? "block" : "none";
        });
    </script>
}
