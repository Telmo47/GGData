@page
@model LoginModel

@{
    // Define o título da página como "Iniciar Sessão"
    ViewData["Title"] = "Iniciar Sessão";
}

<!-- Cabeçalho principal com o título da página -->
<h1>@ViewData["Title"]</h1>

<div class="row">
    <div class="col-md-4">
        <section>
            <!-- Formulário de login com método POST -->
            <form id="account" method="post">
                <h2>Use a sua conta para iniciar sessão.</h2>
                <hr />

                <!-- Sumário de validação para erros do modelo -->
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                <!-- Campo para email com label flutuante e validação -->
                <div class="form-floating mb-3">
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="email@exemplo.com" />
                    <label asp-for="Input.Email" class="form-label">Email</label>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <!-- Campo para palavra-passe com label flutuante e validação -->
                <div class="form-floating mb-3">
                    <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="palavra-passe" />
                    <label asp-for="Input.Password" class="form-label">Palavra-passe</label>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>

                <!-- Botão para submeter o formulário -->
                <div>
                    <button id="login-submit" type="submit" class="w-100 btn btn-lg btn-primary">Iniciar Sessão</button>
                </div>

                <!-- Link para página de registo para utilizadores sem conta -->
                <div class="mt-3">
                    <p>
                        <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Ainda não tem conta? Registar-se</a>
                    </p>
                </div>
            </form>
        </section>
    </div>
</div>

<!-- Inclusão dos scripts de validação do lado do cliente -->
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
