@page
@model LoginModel

@{
    // Define o título da página para apresentar no browser e no cabeçalho
    ViewData["Title"] = "Iniciar Sessão";
}

<h1>@ViewData["Title"]</h1>

<div class="row">
    <div class="col-md-4">
        <section>
            <!-- Formulário para iniciar sessão -->
            <form id="account" method="post">
                <h2>Use a sua conta para iniciar sessão.</h2>
                <hr />

                <!-- Exibe sumário de validação de erros -->
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                <!-- Campo para o email -->
                <div class="form-floating mb-3">
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="email@exemplo.com" />
                    <label asp-for="Input.Email" class="form-label">Email</label>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <!-- Campo para a palavra-passe -->
                <div class="form-floating mb-3">
                    <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="palavra-passe" />
                    <label asp-for="Input.Password" class="form-label">Palavra-passe</label>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>

                <!-- Botão para submeter o formulário e iniciar sessão -->
                <div>
                    <button id="login-submit" type="submit" class="w-100 btn btn-lg btn-primary">Iniciar Sessão</button>
                </div>

                <!-- Link para registar uma nova conta caso não tenha -->
                <div class="mt-3">
                    <p>
                        <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Ainda não tem conta? Registar-se</a>
                    </p>
                </div>
            </form>
        </section>
    </div>
</div>

@section Scripts {
    <!-- Inclui os scripts de validação do asp.net -->
    <partial name="_ValidationScriptsPartial" />
}
