@page
@model LogoutModel

@{
    // Título da página
    ViewData["Title"] = "Terminar Sessão";
}

<header>
    <h1>@ViewData["Title"]</h1>

    @{
        // Verifica se o utilizador está autenticado
        if (User.Identity?.IsAuthenticated ?? false)
        {
            // Formulário para terminar a sessão (logout)
            <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/", new { area = "" })" method="post">
                <button type="submit" class="nav-link btn btn-link text-dark">Terminar Sessão</button>
            </form>
        }
        else
        {
            // Mensagem após logout bem sucedido
            <p>Terminou a sessão com sucesso.</p>
        }
    }
</header>
