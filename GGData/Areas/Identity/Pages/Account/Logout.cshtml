@page
@model LogoutModel
@{
    // Define o título da página como "Log out" (Terminar Sessão)
    ViewData["Title"] = "Log out";
}

<header>
    <!-- Cabeçalho com o título da página -->
    <h1>@ViewData["Title"]</h1>

    @{
        // Verifica se o utilizador está autenticado
        if (User.Identity?.IsAuthenticated ?? false)
        {
            // Se estiver autenticado, mostra um formulário com botão para terminar sessão (POST)
            <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/", new { area = "" })" method="post">
                <button type="submit" class="nav-link btn btn-link text-dark">
                    <!-- Texto do botão a traduzir -->
                    Click here to Logout
                </button>
            </form>
        }
        else
        {
            // Se já não estiver autenticado, mostra mensagem de sucesso na saída da aplicação
            <p>You have successfully logged out of the application.</p>
        }
    }
</header>
