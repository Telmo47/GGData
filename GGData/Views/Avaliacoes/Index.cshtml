@model IEnumerable<GGData.Models.Avaliacao>

@{
    ViewData["Title"] = "Avaliações"; // Define o título da página
    var currentUserName = (string)ViewBag.CurrentUserName; // Obtém o nome do utilizador atual para controlo de permissões
}

<h1>Avaliações</h1>

<!-- Botão para criar uma nova avaliação -->
<p>
    <a asp-action="Create" class="btn btn-primary">Criar Nova Avaliação</a>
</p>

<!-- Tabela que lista todas as avaliações -->
<table class="table">
    <thead>
        <tr>
            <th>Nota</th>
            <th>Comentários</th>
            <th>Data Review</th>
            <th>Tipo Usuário</th>
            <th>Usuário</th>
            <th>Jogo</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Nota</td> <!-- Nota da avaliação -->
                <td>@item.Comentarios</td> <!-- Comentários da avaliação -->
                <td>@item.DataReview</td> <!-- Data da avaliação -->
                <td>@item.TipoUsuario</td> <!-- Tipo do utilizador que avaliou -->
                <td>@item.Utilizador.UserName</td> <!-- Nome do utilizador que fez a avaliação -->
                <td>@item.Jogo.Nome</td> <!-- Nome do jogo avaliado -->
                <td>
                    @* Se o utilizador está autenticado e é o dono da avaliação ou administrador, permite editar, ver detalhes e apagar *@
                    @if (User.Identity.IsAuthenticated && (item.Utilizador.UserName == currentUserName || User.IsInRole("Administrador")))
                    {
                        <a asp-action="Edit" asp-route-id="@item.AvaliacaoId">Editar</a>
                        <text> | </text>
                        <a asp-action="Details" asp-route-id="@item.AvaliacaoId">Detalhes</a>
                        <text> | </text>
                        <a asp-action="Delete" asp-route-id="@item.AvaliacaoId">Apagar</a>
                    }
                    else
                    {
                        <!-- Caso contrário, apenas pode ver os detalhes -->
                        <a asp-action="Details" asp-route-id="@item.AvaliacaoId">Detalhes</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
