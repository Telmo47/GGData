@model GGData.Models.Avaliacao

@{
    ViewData["Title"] = "Eliminar Avaliação";
}

<h1>Eliminar Avaliação</h1>

<h3>Tem a certeza que deseja eliminar esta avaliação?</h3>

<div>
    <h4>Avaliação</h4>
    <hr />

    <!-- Detalhes da avaliação mostrados em formato de definição (dl) -->
    <dl class="row">
        <!-- Nota da avaliação -->
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Nota)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Nota)
        </dd>

        <!-- Comentários -->
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Comentarios)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Comentarios)
        </dd>

        <!-- Data da review -->
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.DataReview)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.DataReview)
        </dd>

        <!-- Tipo de utilizador que fez a avaliação -->
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.TipoUsuario)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.TipoUsuario)
        </dd>

        <!-- ID do utilizador que fez a avaliação -->
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Utilizador)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Utilizador.Id)
        </dd>

        <!-- ID do jogo avaliado -->
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Jogo)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Jogo.JogoId)
        </dd>
    </dl>

    <!-- Formulário para confirmar a eliminação -->
    <form asp-action="Delete">
        <!-- Campo oculto para enviar o ID da avaliação -->
        <input type="hidden" asp-for="AvaliacaoId" />

        <!-- Botão para confirmar eliminação -->
        <input type="submit" value="Eliminar" class="btn btn-danger" /> |

        <!-- Link para voltar para a lista de avaliações -->
        <a asp-action="Index">Voltar à Lista</a>
    </form>
</div>
