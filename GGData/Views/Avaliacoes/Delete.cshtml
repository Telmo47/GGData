@model GGData.Models.Avaliacao

@{
    ViewData["Title"] = "Delete";
}

<h1>Eliminar Avaliação</h1>

<h3>Tem a certeza que quer eliminar esta avaliação?</h3>

<div>
    <h4>Detalhes da Avaliação</h4>
    <hr />
    <dl class="row">
        <!-- Mostrar a nota dada -->
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Nota)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Nota)</dd>

        <!-- Mostrar os comentários -->
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Comentarios)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Comentarios)</dd>

        <!-- Mostrar a data da review -->
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.DataReview)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.DataReview)</dd>

        <!-- Mostrar tipo de utilizador que avaliou -->
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.TipoUsuario)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.TipoUsuario)</dd>

        <!-- Mostrar Id do utilizador que fez a avaliação -->
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Utilizador)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Utilizador.Id)</dd>

        <!-- Mostrar Id do jogo avaliado -->
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Jogo)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Jogo.JogoId)</dd>
    </dl>

    <!-- Formulário para confirmar a eliminação -->
    <form asp-action="Delete">
        <!-- Esconde o Id da avaliação para envio no POST -->
        <input type="hidden" asp-for="AvaliacaoId" />
        <input type="submit" value="Eliminar" class="btn btn-danger" /> |
        <a asp-action="Index" class="btn btn-secondary">Voltar à Lista</a>
    </form>
</div>
