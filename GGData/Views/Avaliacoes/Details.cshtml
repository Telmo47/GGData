@model GGData.Models.Avaliacao

@{
    ViewData["Title"] = "Detalhes da Avaliação";
}

<h1>Detalhes da Avaliação</h1>

<div>
    <h4>Avaliação</h4>
    <hr />

    <!-- Exibição dos detalhes da avaliação em formato de definição (dl) -->
    <dl class="row">
        <!-- Nota atribuída -->
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Nota)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Nota)
        </dd>

        <!-- Comentários do utilizador -->
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Comentarios)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Comentarios)
        </dd>

        <!-- Data da avaliação -->
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.DataReview)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.DataReview)
        </dd>

        <!-- Tipo de utilizador que fez a avaliação (Crítico/Utilizador) -->
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.TipoUsuario)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.TipoUsuario)
        </dd>

        <!-- ID do utilizador que fez a avaliação -->
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Utilizador)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Utilizador.Id)
        </dd>

        <!-- ID do jogo avaliado -->
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Jogo)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Jogo.JogoId)
        </dd>
    </dl>
</div>

<!-- Links para editar a avaliação ou voltar para a lista -->
<div>
    <a asp-action="Edit" asp-route-id="@Model?.AvaliacaoId">Editar</a> |
    <a asp-action="Index">Voltar à Lista</a>
</div>
