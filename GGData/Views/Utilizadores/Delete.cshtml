@model GGData.Models.Utilizadores
<!--
Define que o modelo da View é a classe Utilizadores,
que representa um utilizador no sistema.
-->
@{
    ViewData["Title"] = "Delete";
    // Define o título da página para "Delete"
}

<h1>Delete</h1>
<!-- Título principal da página -->

<h3>Are you sure you want to delete this?</h3>
<!-- Pergunta de confirmação para apagar o utilizador -->

<div>
    <h4>Usuarios</h4>
    <hr />
    <!-- Lista detalhada das propriedades do utilizador a apagar,
         apresentada num formato de definição (dl, dt, dd) com colunas bootstrap -->
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Nome)
            <!-- Nome do campo (label) para Nome -->
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Nome)
            <!-- Valor da propriedade Nome -->
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.DataRegistro)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.DataRegistro)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Email)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Email)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.TipoUsuario)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.TipoUsuario)
        </dd>
    </dl>

    <!-- Formulário que submete a ação de Delete no controller -->
    <form asp-action="Delete">
        <!-- Campo oculto com o Id do utilizador para identificar qual apagar -->
        <input type="hidden" asp-for="Id" />
        <!-- Botão para confirmar a eliminação -->
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <!-- Link para voltar à lista de utilizadores -->
        <a asp-action="Index">Back to List</a>
    </form>
</div>
