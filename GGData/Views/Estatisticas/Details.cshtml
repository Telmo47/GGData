@model GGData.Models.Estatistica

@{
    ViewData["Title"] = "Detalhes da Estatística";
}

<h1>Detalhes da Estatística</h1>

<div>
    <h4>Estatística</h4>
    <hr />
    <!-- Exibe os detalhes da estatística em formato de lista de definição -->
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Conquistas)  <!-- Nome do campo "Conquistas" -->
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Conquistas)      <!-- Valor das conquistas -->
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.TempoMedioJogo)  <!-- Nome do campo "Tempo Médio de Jogo" -->
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.TempoMedioJogo)      <!-- Valor do tempo médio de jogo -->
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.TotalAvaliacoes)  <!-- Nome do campo "Total de Avaliações" -->
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.TotalAvaliacoes)      <!-- Valor do total de avaliações -->
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.MediaNotaUtilizadores)  <!-- Nome do campo "Média das Notas dos Utilizadores" -->
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.MediaNotaUtilizadores)      <!-- Valor da média das notas dos utilizadores -->
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.MediaNotaCriticos)  <!-- Nome do campo "Média das Notas dos Críticos" -->
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.MediaNotaCriticos)      <!-- Valor da média das notas dos críticos -->
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Jogo)  <!-- Nome do campo "Jogo" -->
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Jogo.JogoId)  <!-- ID do jogo associado -->
        </dd>
    </dl>
</div>

<!-- Links para editar a estatística ou voltar à lista -->
<div>
    <a asp-action="Edit" asp-route-id="@Model?.EstatisticaId">Editar</a> |
    <a asp-action="Index">Voltar à Lista</a>
</div>
