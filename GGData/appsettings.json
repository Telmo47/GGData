{
  // Strings de ligação à base de dados
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=GGData;Trusted_Connection=True;MultipleActiveResultSets=true"
    // Usa o LocalDB do SQL Server, base de dados chamada GGData, com conexão segura e suporte para múltiplos comandos simultâneos
  },

  // Configuração para JWT (Json Web Token) para autenticação via API
  "Jwt": {
    "Key": "uma-chave-muito-secreta-e-comprida-para-assinar-o-token",
    "Issuer": "GGDataAPI",
    "Audience": "GGDataUsers",
    "ExpireHours": "24"
    // Key: Chave secreta para assinar tokens JWT
    // Issuer: Quem emite o token
    // Audience: Destinatários válidos do token
    // ExpireHours: Duração da validade do token em horas (24h)
  },

  // Configuração do logging
  "Logging": {
    "LogLevel": {
      "Default": "Information", // Nível padrão de logs
      "Microsoft.AspNetCore": "Warning" // Logs do ASP.NET Core só para warnings ou erros
    }
  },

  // Hosts permitidos para a aplicação (usar "*" para todos)
  "AllowedHosts": "*"
}
